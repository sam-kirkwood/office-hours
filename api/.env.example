# Copy to api/.env and fill in. Do not commit .env.

# --- Anthropic ---
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- Supabase ---
# Same project as the web app. Service-role key — server-only, bypasses RLS.
# Naming: anon→publishable, service_role→secret (new Supabase convention).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Internal auth ---
# Shared bearer token between the Next.js web app and this Python service.
# Must match web/.env.local INTERNAL_API_TOKEN. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# --- Server ---
# Optional; defaults shown.
PORT=8000
LOG_LEVEL=INFO
