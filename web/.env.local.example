# Copy this file to .env.local and fill in values from:
# Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never expose this in the browser — used only in API routes
SUPABASE_SECRET_KEY=

# Python FastAPI service (api/). Default to localhost in dev.
PYTHON_API_URL=http://localhost:8000

# Shared bearer token between Next.js and the Python service. Must match
# INTERNAL_API_TOKEN in api/.env.
INTERNAL_API_TOKEN=
